# Packaging rules for CurseForge's packager (BigWigs .pkgmeta format).
# Keeps development-only files out of the addon that players download.
# Dotfiles and .github/ are always excluded by the packager itself.
package-as: TransmogChecker

# The CurseForge file's changelog is our text, not commit subjects.
# The packager reads it from the source tree, so the ignore entry below still keeps it out of the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - dev
  - CLAUDE.md
  - GLOSSARY.md
  - CHANGELOG.md
  - docs
  - Media/Flags/README.md
